{% extends 'base.html.twig' %}

{% block body_class %}layout-fluid{% endblock %}

{% block body %}
<div class="page">
    <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark" aria-label="Navigazione principale">
        <div class="container-fluid">
            <h1 class="navbar-brand navbar-brand-autodark">
                <a href="{{ path('app_dashboard') }}" class="text-decoration-none text-white">
                    <span class="brand-mark" aria-hidden="true">SC</span>
                    <span class="ms-2">{{ app_name }}</span>
                </a>
            </h1>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Apri navigazione">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="sidebar-menu">
                <ul class="navbar-nav pt-lg-3">
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'active' : '' }}" href="{{ path('app_dashboard') }}" aria-current="{{ app.request.attributes.get('_route') == 'app_dashboard' ? 'page' : 'false' }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h6v8H4z"/><path d="M14 4h6v4h-6z"/><path d="M14 12h6v8h-6z"/><path d="M4 16h6v4H4z"/></svg>
                            </span>
                            <span class="nav-link-title">Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_project_' ? 'active' : '' }}" href="{{ path('app_project_index') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_project_' ? 'page' : 'false' }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h18"/><path d="M5 7l1 -4h12l1 4"/><path d="M5 7v13h14V7"/><path d="M9 11h6"/></svg>
                            </span>
                            <span class="nav-link-title">Commesse</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ (app.request.attributes.get('_route') starts with 'app_activity_' and app.request.attributes.get('_route') != 'app_activity_time') ? 'active' : '' }}" href="{{ path('app_activity_index') }}" aria-current="{{ (app.request.attributes.get('_route') starts with 'app_activity_' and app.request.attributes.get('_route') != 'app_activity_time') ? 'page' : 'false' }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3l8 -8"/><path d="M20 12v6a2 2 0 0 1 -2 2H6a2 2 0 0 1 -2 -2V6a2 2 0 0 1 2 -2h9"/></svg>
                            </span>
                            <span class="nav-link-title">Attività</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ (app.request.attributes.get('_route') starts with 'app_time_entry_' or app.request.attributes.get('_route') == 'app_activity_time') ? 'active' : '' }}" href="{{ path('app_time_entry_index') }}" aria-current="{{ (app.request.attributes.get('_route') starts with 'app_time_entry_' or app.request.attributes.get('_route') == 'app_activity_time') ? 'page' : 'false' }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7v5l3 2"/><path d="M12 21a9 9 0 1 0 0 -18a9 9 0 0 0 0 18"/></svg>
                            </span>
                            <span class="nav-link-title">Ore</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_attachment_' ? 'active' : '' }}" href="{{ path('app_attachment_index') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_attachment_' ? 'page' : 'false' }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 8h.01"/><path d="M12 20h-5a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h8l4 4v5"/><path d="M14 4v4h4"/><path d="M15 18l2 2l4 -4"/></svg>
                            </span>
                            <span class="nav-link-title">Documenti</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_client_' ? 'active' : '' }}" href="{{ path('app_client_index') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_client_' ? 'page' : 'false' }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"/><path d="M5 21V7l8 -4v18"/><path d="M19 21V11l-6 -4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/></svg>
                            </span>
                            <span class="nav-link-title">Clienti</span>
                        </a>
                    </li>
                    {% if is_granted('ROLE_PARTNER') %}
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_monthly_report' ? 'active' : '' }}" href="{{ path('app_monthly_report') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_monthly_report' ? 'page' : 'false' }}">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16v16H4z"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="M4 9h16"/><path d="M8 13h2"/><path d="M14 13h2"/><path d="M8 17h2"/></svg></span>
                                <span class="nav-link-title">Report mensile</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_control_' ? 'active' : '' }}" href="{{ path('app_control_index') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_control_' ? 'page' : 'false' }}">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19V9"/><path d="M10 19V5"/><path d="M16 19v-7"/><path d="M22 19V3"/><path d="M2 19h22"/></svg></span>
                                <span class="nav-link-title">Controllo</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_economics_' or app.request.attributes.get('_route') starts with 'app_expense_' or app.request.attributes.get('_route') starts with 'app_payment_' ? 'active' : '' }}" href="{{ path('app_economics_index') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_economics_' or app.request.attributes.get('_route') starts with 'app_expense_' or app.request.attributes.get('_route') starts with 'app_payment_' ? 'page' : 'false' }}">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9m0 2a2 2 0 1 0 0 -4a2 2 0 0 0 0 4"/><path d="M17 9m0 2a2 2 0 1 0 0 -4a2 2 0 0 0 0 4"/><path d="M7 15m0 2a2 2 0 1 0 0 -4a2 2 0 0 0 0 4"/><path d="M17 15m0 2a2 2 0 1 0 0 -4a2 2 0 0 0 0 4"/><path d="M9 9h6"/><path d="M9 15h6"/></svg></span>
                                <span class="nav-link-title">Economia</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_audit_' ? 'active' : '' }}" href="{{ path('app_audit_index') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_audit_' ? 'page' : 'false' }}">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12l2 2l4 -4"/><path d="M12 3l7 4v5c0 5 -3 8 -7 9c-4 -1 -7 -4 -7 -9V7z"/></svg>
                                </span>
                                <span class="nav-link-title">Audit</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_user_' ? 'active' : '' }}" href="{{ path('app_user_index') }}" aria-current="{{ app.request.attributes.get('_route') starts with 'app_user_' ? 'page' : 'false' }}">
                                <span class="nav-link-icon d-md-none d-lg-inline-block" aria-hidden="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11a4 4 0 1 0 0 -8a4 4 0 0 0 0 8"/><path d="M17 13a4 4 0 1 0 0 -8"/><path d="M17 21v-2a4 4 0 0 0 -4 -4H5a4 4 0 0 0 -4 4v2"/><path d="M21 21v-2a4 4 0 0 0 -3 -3.87"/></svg>
                                </span>
                                <span class="nav-link-title">Utenti</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </aside>

    <header class="navbar navbar-expand-md d-none d-lg-flex d-print-none">
        <div class="container-xl">
            <div class="navbar-nav flex-row order-md-last ms-auto">
                <div class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Apri menu utente">
                        <span class="avatar avatar-sm">{{ app.user.displayName|slice(0, 2)|upper }}</span>
                        <div class="d-none d-xl-block ps-2">
                            <div>{{ app.user.displayName }}</div>
                            <div class="mt-1 small text-secondary">{{ app.user.role.label }}</div>
                        </div>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                        <form action="{{ path('app_logout') }}" method="post">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                            <button type="submit" class="dropdown-item">Esci</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="page-wrapper" id="main-content" tabindex="-1">
        <div class="page-header d-print-none">
            <div class="container-xl">
                <div class="row g-2 align-items-center">
                    <div class="col">
                        <div class="page-pretitle">{{ app_name }}</div>
                        <h2 class="page-title">{% block page_title %}Dashboard{% endblock %}</h2>
                    </div>
                    <div class="col-auto ms-auto d-print-none">
                        {% block page_actions %}{% endblock %}
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                {% include 'components/flash_messages.html.twig' %}
                {% block page_body %}{% endblock %}
            </div>
        </div>

        <footer class="footer footer-transparent d-print-none">
            <div class="container-xl">
                <div class="row text-center align-items-center flex-row-reverse">
                    <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                        <span class="text-secondary">{{ app_name }} · {{ app_version }}</span>
                    </div>
                </div>
            </div>
        </footer>
    </main>
</div>
{% endblock %}
