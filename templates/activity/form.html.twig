{% extends 'layout/app.html.twig' %}

{% block title %}{{ page_title }} · {{ app_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}
{% block page_actions %}
<div class="btn-list">
    <a href="{{ path('app_project_show', {id: activity.project.id}) }}" class="btn btn-outline-secondary">Torna alla commessa</a>
    <a href="{{ path('app_attachment_project', {id: activity.project.id, activity: activity.id}) }}" class="btn btn-outline-primary">Documenti{% if attachment_count > 0 %} ({{ attachment_count }}){% endif %}</a>
</div>
{% endblock %}

{% block page_body %}
<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card">
            {{ form_start(form, {attr: {autocomplete: 'off'}}) }}
            <div class="card-body">
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-12 col-lg-6">{{ form_row(form.title) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.assignee) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.status) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.priority) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.progressPercent) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.initialEstimatedMinutes) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.remainingEstimatedMinutes) }}</div>
                    {% if form.hourlyRateOverrideCents is defined %}
                        <div class="col-12 col-lg-6">{{ form_row(form.hourlyRateOverrideCents) }}</div>
                    {% endif %}
                    <div class="col-12 col-lg-6">{{ form_row(form.startAt) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.dueAt) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                </div>
                {{ form_rest(form) }}
            </div>
            <div class="card-footer">
                <button class="btn btn-primary w-100" type="submit">{{ submit_label }}</button>
            </div>
            {{ form_end(form, {render_rest: false}) }}
        </div>
    </div>
</div>
{% endblock %}
