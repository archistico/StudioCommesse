{% extends 'layout/app.html.twig' %}

{% block title %}{{ page_title }} · {{ app_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}
{% block page_back %}{% include 'components/back_link.html.twig' with {url: path('app_user_index'), label: 'Torna agli utenti'} only %}{% endblock %}
{% block page_actions %}
{% if edited_user is defined %}<a class="btn btn-danger" href="{{ path('app_user_delete', {id: edited_user.id}) }}">{% include 'components/icon.html.twig' with {name: 'trash'} only %}Elimina utente</a>{% endif %}
{% endblock %}

{% block page_body %}
<div class="row justify-content-center form-page">
    <div class="col-12">
        <div class="card">
            {{ form_start(form, {attr: {autocomplete: 'off'}}) }}
            <div class="card-body">
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-12 col-md-6">{{ form_row(form.displayName) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.username) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.role) }}</div>
                    <div class="col-12 col-md-6 d-flex align-items-center">{{ form_row(form.active) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.plainPassword) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.defaultHourlyRateCents) }}</div>
                </div>
                {{ form_rest(form) }}
            </div>
            <div class="card-footer form-actions">
                <a class="btn btn-outline-secondary" href="{{ path('app_user_index') }}">{% include 'components/icon.html.twig' with {name: 'arrow-left'} only %}Annulla</a>
                <button type="submit" class="btn btn-primary">{% include 'components/icon.html.twig' with {name: 'device-floppy'} only %}{{ submit_label }}</button>
            </div>
            {{ form_end(form, {render_rest: false}) }}
        </div>
    </div>
</div>
{% endblock %}
