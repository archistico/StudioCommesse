{% extends 'base.html.twig' %}

{% block title %}Errore interno · {{ app_name }}{% endblock %}
{% block body_class %}d-flex flex-column{% endblock %}

{% block body %}
<main class="page page-center" id="main-content" tabindex="-1">
    <div class="container-tight py-4 text-center">
        <div class="empty">
            <div class="empty-header">500</div>
            <p class="empty-title">Operazione non completata</p>
            <p class="empty-subtitle text-secondary">Si è verificato un errore interno. Nessun dettaglio tecnico è stato esposto.</p>
            {% set rid = request_id|default(app.request.attributes.get('_studio_commesse_request_id')) %}
            {% if rid %}<p class="text-secondary small">Riferimento: {{ rid }}</p>{% endif %}
            <div class="empty-action"><a href="{{ path('app_dashboard') }}" class="btn btn-primary">Torna alla dashboard</a></div>
        </div>
    </div>
</main>
{% endblock %}
