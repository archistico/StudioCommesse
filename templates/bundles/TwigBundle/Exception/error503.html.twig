{% extends 'base.html.twig' %}

{% block title %}Temporaneamente non disponibile · {{ app_name }}{% endblock %}
{% block body_class %}d-flex flex-column{% endblock %}

{% block body %}
<main class="page page-center" id="main-content" tabindex="-1">
    <div class="container-tight py-4 text-center">
        <div class="empty">
            <div class="empty-header">503</div>
            <p class="empty-title">Applicazione temporaneamente occupata</p>
            <p class="empty-subtitle text-secondary">{{ maintenance_message|default('È in corso un’operazione esclusiva oppure il database è momentaneamente occupato. Riprova tra pochi secondi.') }}</p>
            {% set rid = request_id|default(app.request.attributes.get('_studio_commesse_request_id')) %}
            {% if rid %}<p class="text-secondary small">Riferimento: {{ rid }}</p>{% endif %}
            <div class="empty-action"><a href="{{ path('app_dashboard') }}" class="btn btn-primary">Riprova dalla dashboard</a></div>
        </div>
    </div>
</main>
{% endblock %}
