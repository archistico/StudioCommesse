{% extends 'base.html.twig' %}

{% block title %}Conflitto · {{ app_name }}{% endblock %}
{% block body_class %}d-flex flex-column{% endblock %}

{% block body %}
<main class="page page-center" id="main-content" tabindex="-1">
    <div class="container-tight py-4 text-center">
        <div class="empty">
            <div class="empty-header">409</div>
            <p class="empty-title">Dati modificati o già presenti</p>
            <p class="empty-subtitle text-secondary">L’operazione non è stata applicata. Ricarica la pagina e verifica i dati prima di riprovare.</p>
            {% if request_id is defined and request_id %}<p class="text-secondary small">Riferimento: {{ request_id }}</p>{% endif %}
            <div class="empty-action"><a href="{{ path('app_dashboard') }}" class="btn btn-primary">Torna alla dashboard</a></div>
        </div>
    </div>
</main>
{% endblock %}
