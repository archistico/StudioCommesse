{% extends 'layout/app.html.twig' %}

{% block title %}Valutazione di {{ evaluation.displayName }} · {{ app_name }}{% endblock %}
{% block page_title %}Valutazione collaboratore{% endblock %}
{% block page_actions %}
    <a href="{{ path('app_control_index', control_query) }}" class="btn btn-outline-secondary">Torna al controllo</a>
    <a href="{{ path('app_time_entry_index', time_report_query) }}" class="btn btn-outline-primary">Apri registrazioni ore</a>
{% endblock %}

{% block page_body %}
{% if date_error %}<div class="alert alert-warning">{{ date_error }}</div>{% endif %}

<div class="card mb-3">
    <div class="card-body d-flex flex-column flex-md-row align-items-md-center gap-3">
        <div class="flex-fill">
            <div class="h2 mb-1">{{ evaluation.displayName }}</div>
            <div class="text-secondary">{{ evaluation.roleLabel }} · {{ evaluation.active ? 'attivo' : 'disattivato' }}</div>
        </div>
        <div class="text-md-end">
            <div class="text-secondary">Periodo valutato</div>
            <div class="fw-semibold">{{ evaluation.periodFrom|date('d/m/Y') }} – {{ evaluation.periodTo|date('d/m/Y') }}</div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    Le giornate sono determinate dalla data di inizio della registrazione. I timer ancora aperti non entrano nelle ore totali finché non vengono chiusi.
</div>

<div class="card mb-3">
    <div class="card-header"><h3 class="card-title">Filtri della valutazione</h3></div>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <input type="hidden" name="closure" value="{{ control_context.closure }}">
            <input type="hidden" name="critical" value="{{ control_context.critical }}">
            <input type="hidden" name="sort" value="{{ control_context.sort }}">
            <input type="hidden" name="direction" value="{{ control_context.direction }}">
            <div class="col-12 col-lg-4 col-xl-3">
                <label for="evaluation-client" class="form-label">Cliente</label>
                <select id="evaluation-client" name="client" class="form-select">
                    <option value="">Tutti i clienti</option>
                    {% for client in clients_filter %}
                        <option value="{{ client.id }}" {{ selected_client and selected_client.id == client.id ? 'selected' : '' }}>{{ client.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-4 col-xl-3">
                <label for="evaluation-responsible" class="form-label">Responsabile commessa</label>
                <select id="evaluation-responsible" name="responsible" class="form-select">
                    <option value="">Tutti i responsabili</option>
                    {% for responsible in responsibles_filter %}
                        <option value="{{ responsible.id }}" {{ selected_responsible and selected_responsible.id == responsible.id ? 'selected' : '' }}>{{ responsible.displayName }}{{ responsible.active ? '' : ' (disattivato)' }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-4 col-xl-3">
                <label for="evaluation-project" class="form-label">Commessa</label>
                <select id="evaluation-project" name="project" class="form-select">
                    <option value="">Tutte le commesse</option>
                    {% for project in projects_filter %}
                        <option value="{{ project.id }}" {{ selected_project and selected_project.id == project.id ? 'selected' : '' }}>{{ project.code }} · {{ project.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-4 col-xl-3">
                <label for="evaluation-billable" class="form-label">Fatturabilità</label>
                <select id="evaluation-billable" name="billable" class="form-select">
                    <option value="" {{ billable_value == '' ? 'selected' : '' }}>Tutte</option>
                    <option value="1" {{ billable_value == '1' ? 'selected' : '' }}>Fatturabili</option>
                    <option value="0" {{ billable_value == '0' ? 'selected' : '' }}>Non fatturabili</option>
                </select>
            </div>
            <div class="col-12 col-lg-3 col-xl-2">
                <label for="evaluation-from" class="form-label">Dal</label>
                <input id="evaluation-from" name="from" type="date" class="form-control" value="{{ date_from }}">
            </div>
            <div class="col-12 col-lg-3 col-xl-2">
                <label for="evaluation-to" class="form-label">Al</label>
                <input id="evaluation-to" name="to" type="date" class="form-control" value="{{ date_to }}">
            </div>
            <div class="col-12 col-lg-auto"><button class="btn btn-primary w-100" type="submit">Applica filtri</button></div>
            <div class="col-12 col-lg-auto"><a href="{{ path('app_control_collaborator_show', {id: evaluation.userId}) }}" class="btn btn-outline-secondary w-100">Azzera</a></div>
        </form>
    </div>
</div>

<div class="row row-cards mb-3">
    <div class="col-12 col-lg-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-secondary">Ore totali</div><div class="h2 mb-0">{{ evaluation.totalMinutes|duration_hm }}</div></div></div></div>
    <div class="col-12 col-lg-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-secondary">Ore fatturabili</div><div class="h2 mb-0">{{ evaluation.billableMinutes|duration_hm }}</div></div></div></div>
    <div class="col-12 col-lg-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-secondary">Giornate lavorate</div><div class="h2 mb-0">{{ evaluation.workedDayCount }}</div></div></div></div>
    <div class="col-12 col-lg-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-secondary">Media per giornata</div><div class="h2 mb-0">{{ evaluation.averageMinutesPerWorkedDay|duration_hm }}</div></div></div></div>
    <div class="col-12 col-lg-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-secondary">Registrazioni</div><div class="h2 mb-0">{{ evaluation.entryCount }}</div></div></div></div>
    <div class="col-12 col-lg-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="text-secondary">Commesse</div><div class="h2 mb-0">{{ evaluation.projectCount }}</div></div></div></div>
</div>

<div class="d-flex align-items-center mb-2"><h3 class="mb-0">Dettaglio giornaliero</h3></div>

{% for day in evaluation.days %}
    <div class="card mb-3">
        <div class="card-header">
            <div>
                <h3 class="card-title">{{ day.date|date('d/m/Y') }}</h3>
                <div class="small text-secondary">{{ day.entries|length }} {{ day.entries|length == 1 ? 'registrazione' : 'registrazioni' }}</div>
            </div>
            <div class="ms-auto text-end">
                <div class="small text-secondary">Totale giorno</div>
                <div class="h3 mb-0">{{ day.totalMinutes|duration_hm }}</div>
                <div class="small text-secondary">{{ day.billableMinutes|duration_hm }} fatturabili</div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table dt-responsive nowrap w-100" data-datatable data-datatable-compact="true">
                <thead><tr><th>Intervallo</th><th>Commessa</th><th>Attività</th><th>Lavoro svolto</th><th>Durata</th><th>Fatturabile</th></tr></thead>
                <tbody>
                {% for entry in day.entries %}
                    <tr>
                        <td data-order="{{ entry.startedAt|date('H:i:s') }}" class="text-nowrap">{{ entry.startedAt|date('H:i') }}–{{ entry.endedAt|date('H:i') }}</td>
                        <td>
                            <a class="fw-semibold" href="{{ path('app_project_show', {id: entry.projectId}) }}">{{ entry.projectCode }}</a>
                            <div class="small text-secondary">{{ entry.projectName }}</div>
                        </td>
                        <td><a href="{{ path('app_activity_time', {id: entry.activityId}) }}">{{ entry.activityTitle }}</a></td>
                        <td>{{ entry.description ?: 'Descrizione non inserita' }}</td>
                        <td data-order="{{ entry.durationMinutes }}" class="fw-semibold text-nowrap">{{ entry.durationMinutes|duration_hm }}</td>
                        <td data-order="{{ entry.billable ? 1 : 0 }}"><span class="badge {{ entry.billable ? 'bg-green-lt' : 'bg-secondary-lt' }}">{{ entry.billable ? 'Sì' : 'No' }}</span></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% else %}
    <div class="card"><div class="card-body text-center text-secondary py-5">Nessuna ora chiusa per questa persona nel periodo e nei filtri selezionati.</div></div>
{% endfor %}
{% endblock %}
