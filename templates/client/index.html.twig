{% extends 'layout/app.html.twig' %}

{% block title %}Clienti · {{ app_name }}{% endblock %}
{% block page_title %}Clienti{% endblock %}
{% block page_actions %}
    {% if is_granted('ROLE_PARTNER') %}
        <div class="btn-list">
            <a href="{{ path('app_economics_index') }}#importi-clienti" class="btn btn-outline-primary">Riepilogo dovuti</a>
            <a href="{{ path('app_client_new') }}" class="btn btn-primary">Nuovo cliente</a>
        </div>
    {% endif %}
{% endblock %}

{% block page_body %}
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-lg-8">
                <label class="form-label" for="client-search">Ricerca</label>
                <input id="client-search" type="search" name="q" value="{{ query }}" class="form-control" placeholder="Nome, referente o e-mail">
            </div>
            <div class="col-12 col-lg-2">
                <label class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" name="archiviati" value="1" {{ include_archived ? 'checked' : '' }}>
                    <span class="form-check-label">Includi archiviati</span>
                </label>
            </div>
            <div class="col-12 col-lg-2 d-flex gap-2">
                <button class="btn btn-primary flex-fill" type="submit">Filtra</button>
                <a class="btn btn-outline-secondary" href="{{ path('app_client_index') }}" aria-label="Azzera filtri">×</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table dt-responsive nowrap w-100" data-datatable>
            <thead>
            <tr>
                <th scope="col">Cliente</th>
                <th scope="col">Referente</th>
                <th scope="col">Contatti</th>
                {% if is_granted('ROLE_PARTNER') %}<th scope="col">Dovuto</th>{% endif %}
                <th scope="col">Stato</th>
            </tr>
            </thead>
            <tbody>
            {% for client in clients %}
                {% set financial_summary = financial_summaries_by_client_id[client.id]|default(null) %}
                <tr data-client-id="{{ client.id }}" class="{{ client.archived ? 'text-secondary' : '' }}">
                    <td><a href="{{ path('app_client_show', {id: client.id}) }}" class="fw-semibold">{{ client.name }}</a></td>
                    <td>{{ client.contactPerson ?? '—' }}</td>
                    <td>
                        {% if client.email %}<div>{{ client.email }}</div>{% endif %}
                        {% if client.phone %}<div class="text-secondary">{{ client.phone }}</div>{% endif %}
                        {% if not client.email and not client.phone %}—{% endif %}
                    </td>
                    {% if is_granted('ROLE_PARTNER') %}
                        <td
                            class="fw-semibold {{ financial_summary and financial_summary.remainingToCollectCents > 0 ? 'text-warning' : 'text-success' }}"
                            data-order="{{ financial_summary ? financial_summary.remainingToCollectCents : 0 }}"
                        >
                            {{ (financial_summary ? financial_summary.remainingToCollectCents : 0)|money_eur }}
                        </td>
                    {% endif %}
                    <td>
                        {% if client.archived %}
                            <span class="status status-secondary">Archiviato</span>
                        {% else %}
                            <span class="status status-green">Attivo</span>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="{{ is_granted('ROLE_PARTNER') ? 5 : 4 }}" class="text-center text-secondary py-5">Nessun cliente corrisponde ai filtri.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
