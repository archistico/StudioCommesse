{% extends 'layout/app.html.twig' %}

{% block title %}{{ page_title }} · {{ app_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}
{% block page_body %}
<div class="row justify-content-center form-page">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><div><h3 class="card-title">{{ activity.title }}</h3><div class="small text-secondary">{{ activity.project.code }} · {{ activity.project.name }}</div></div></div>
            {{ form_start(form, {attr: {autocomplete: 'off'}}) }}
            <div class="card-body">
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-12 col-md-6">{{ form_row(form.startedAt) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.endedAt) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-12">{{ form_row(form.billable) }}</div>
                </div>
                {{ form_rest(form) }}
            </div>
            <div class="card-footer form-actions">
                <a class="btn btn-outline-secondary" href="{{ path('app_activity_time', {id: activity.id}) }}">Annulla</a>
                <button class="btn btn-primary" type="submit">{{ submit_label }}</button>
            </div>
            {{ form_end(form, {render_rest: false}) }}
        </div>
        {% if entry is defined and is_granted('ROLE_PARTNER') %}
            <div class="card mt-3 border-danger">
                <div class="card-body">
                    <h3 class="card-title text-danger">Elimina registrazione</h3>
                    <p class="text-secondary">La registrazione sarà eliminata definitivamente. Potrai verificarne i dati prima di confermare.</p>
                    <a class="btn btn-outline-danger" href="{{ path('app_time_entry_delete', {id: entry.id}) }}">Elimina registrazione ore</a>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
