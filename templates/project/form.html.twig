{% extends 'layout/app.html.twig' %}

{% block title %}{{ page_title }} · {{ app_name }}{% endblock %}
{% block page_title %}{{ page_title }}{% endblock %}
{% block page_back %}{% include 'components/back_link.html.twig' with {url: project is defined ? path('app_project_show', {id: project.id}) : path('app_project_index'), label: project is defined ? 'Torna alla commessa' : 'Torna alle commesse'} only %}{% endblock %}
{% block page_body %}
<div class="row justify-content-center form-page">
    <div class="col-12">
        <div class="card">
            {{ form_start(form, {attr: {autocomplete: 'off'}}) }}
            <div class="card-body">
                {{ form_errors(form) }}
                <div class="row">
                    <div class="col-12">{{ form_row(form.name) }}</div>
                    {% if allow_administration %}
                        <div class="col-12 col-md-6">{{ form_row(form.client) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(form.responsible) }}</div>
                    {% endif %}
                    <div class="col-12 col-md-6">{{ form_row(form.status) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.priority) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.startDate) }}</div>
                    <div class="col-12 col-md-6">{{ form_row(form.dueDate) }}</div>
                    {% if allow_administration %}
                        <div class="col-12 col-md-6">{{ form_row(form.estimatedAmountCents) }}</div>
                        <div class="col-12 col-md-6">{{ form_row(form.defaultHourlyRateCents) }}</div>
                    {% endif %}
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-12">{{ form_row(form.waitingReason) }}</div>
                    <div class="col-12">{{ form_row(form.privateNote) }}</div>
                </div>
                {{ form_rest(form) }}
            </div>
            <div class="card-footer form-actions">
                <a class="btn btn-outline-secondary" href="{{ project is defined ? path('app_project_show', {id: project.id}) : path('app_project_index') }}">Annulla</a>
                <button class="btn btn-primary" type="submit">{{ submit_label }}</button>
            </div>
            {{ form_end(form, {render_rest: false}) }}
        </div>
        {% if project is defined and is_granted('ROLE_PARTNER') %}
            <div class="card mt-3 border-danger">
                <div class="card-body">
                    <h3 class="card-title text-danger">Cancellazione definitiva</h3>
                    <p class="text-secondary">Cancella la commessa e tutte le attività, ore, timer, spese, incassi e documenti collegati. La pagina successiva mostra il riepilogo e richiede conferma.</p>
                    <a class="btn btn-danger w-100" href="{{ path('app_project_delete', {id: project.id}) }}">Cancella commessa</a>
                </div>
            </div>
            <div class="card mt-3 border-danger">
                <div class="card-body">
                    <h3 class="card-title text-danger">Archiviazione</h3>
                    <p class="text-secondary">I dati archiviati restano consultabili.</p>
                    <form method="post" action="{{ path('app_project_archive', {id: project.id}) }}" data-confirm="Archiviare questa commessa?">
                        <input type="hidden" name="_token" value="{{ csrf_token('archive_project_' ~ project.id) }}">
                        <button class="btn btn-danger w-100" type="submit">Archivia commessa</button>
                    </form>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
