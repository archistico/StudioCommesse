{% extends 'layout/app.html.twig' %}

{% block title %}Commesse · {{ app_name }}{% endblock %}
{% block page_title %}Commesse{% endblock %}
{% block page_actions %}
    {% if is_granted('ROLE_PARTNER') %}<a href="{{ path('app_project_new') }}" class="btn btn-primary">Nuova commessa</a>{% endif %}
{% endblock %}

{% block page_body %}
<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label" for="project-search">Ricerca</label>
                <input id="project-search" type="search" name="q" value="{{ criteria.query ?? '' }}" class="form-control" placeholder="Codice, commessa o cliente">
            </div>
            <div class="col-12 col-lg-2">
                <label class="form-label" for="project-status">Stato</label>
                <select id="project-status" name="stato" class="form-select">
                    <option value="">Tutti</option>
                    {% for status in statuses %}<option value="{{ status.value }}" {{ criteria.status == status ? 'selected' : '' }}>{{ status.label }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-2">
                <label class="form-label" for="project-priority">Priorità</label>
                <select id="project-priority" name="priorita" class="form-select">
                    <option value="">Tutte</option>
                    {% for priority in priorities %}<option value="{{ priority.value }}" {{ criteria.priority == priority ? 'selected' : '' }}>{{ priority.label }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-2">
                <label class="form-label" for="project-responsible">Responsabile</label>
                <select id="project-responsible" name="responsabile" class="form-select">
                    <option value="">Tutti</option>
                    {% for responsible in responsibles %}<option value="{{ responsible.id }}" {{ criteria.responsibleId == responsible.id ? 'selected' : '' }}>{{ responsible.displayName }}{{ responsible.active ? '' : ' (disattivato)' }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-2">
                <label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="archiviate" value="1" {{ criteria.includeArchived ? 'checked' : '' }}><span class="form-check-label">Includi archiviate</span></label>
                <div class="d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit">Filtra</button><a class="btn btn-outline-secondary" href="{{ path('app_project_index') }}" aria-label="Azzera filtri">×</a></div>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-vcenter card-table dt-responsive nowrap w-100" data-datatable>
            <thead><tr><th scope="col">Codice</th><th scope="col">Commessa</th><th scope="col">Cliente</th><th scope="col">Responsabile</th><th scope="col">Stato</th><th scope="col">Priorità</th><th scope="col">Scadenza</th></tr></thead>
            <tbody>
            {% for project in projects %}
                <tr class="{{ project.archived ? 'text-secondary' : '' }}">
                    <td><a href="{{ path('app_project_show', {id: project.id}) }}" class="fw-semibold">{{ project.code }}</a>{% if project.archived %}<div class="small">Archiviata</div>{% endif %}</td>
                    <td>{{ project.name }}</td>
                    <td><a href="{{ path('app_client_show', {id: project.client.id}) }}">{{ project.client.name }}</a></td>
                    <td>{{ project.responsible.displayName }}</td>
                    <td><span class="badge {{ project.status.badgeClass }}">{{ project.status.label }}</span></td>
                    <td data-order="{{ project.priority.value }}" data-priority="{{ project.priority.value }}">
                        <span class="badge {{ project.priority.badgeClass }} d-inline-flex align-items-center justify-content-center p-2" title="Priorità {{ project.priority.label }}" aria-label="Priorità {{ project.priority.label }}">
                            {% if project.priority.value == 'low' %}
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14"/><path d="m18 13l-6 6l-6 -6"/></svg>
                            {% elseif project.priority.value == 'normal' %}
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"/></svg>
                            {% elseif project.priority.value == 'high' %}
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="m6 11l6 -6l6 6"/></svg>
                            {% else %}
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 9v4"/><path d="M12 17v.01"/><path d="M10.3 4.3l-7.3 12.7a2 2 0 0 0 1.7 3h14.6a2 2 0 0 0 1.7 -3l-7.3 -12.7a2 2 0 0 0 -3.4 0z"/></svg>
                            {% endif %}
                        </span>
                    </td>
                    <td data-order="{{ project.dueDate ? project.dueDate|date('Y-m-d') : '9999-12-31' }}">
                        {% if project.dueDate %}
                            <span class="{{ project.overdue ? 'text-danger fw-semibold' : '' }}">{{ project.dueDate|date('d/m/Y') }}</span>
                            {% if project.overdue %}<div class="small text-danger">In ritardo</div>{% endif %}
                        {% else %}—{% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-secondary py-5">Nessuna commessa corrisponde ai filtri.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
