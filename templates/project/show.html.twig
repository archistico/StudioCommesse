{% extends 'layout/app.html.twig' %}

{% block title %}{{ project.code }} · {{ app_name }}{% endblock %}
{% block page_title %}{{ project.code }} · {{ project.name }}{% endblock %}
{% block page_back %}{% include 'components/back_link.html.twig' with {url: path('app_project_index'), label: 'Torna alle commesse'} only %}{% endblock %}
{% block page_actions_layout %}single-row{% endblock %}

{% block page_summary %}
<div class="card mb-3 project-details">
    <div class="card-header project-details-header">
        <h3 class="card-title">Dettagli della commessa</h3>
        {% if is_granted('PROJECT_EDIT', project) %}
            <a href="{{ path('app_project_edit', {id: project.id}) }}" class="btn btn-primary">Modifica</a>
        {% endif %}
    </div>
    <div class="card-body">
        <div class="project-details-grid">
            <dl class="project-detail-column">
                <div><dt>Cliente</dt><dd><a href="{{ path('app_client_show', {id: project.client.id}) }}">{{ project.client.name }}</a></dd></div>
                <div><dt>Responsabile</dt><dd>{{ project.responsible.displayName }}</dd></div>
                <div><dt>Stato</dt><dd><span class="badge {{ project.status.badgeClass }}">{{ project.status.label }}</span></dd></div>
                <div><dt>Priorità</dt><dd><span class="badge {{ project.priority.badgeClass }}">{{ project.priority.label }}</span></dd></div>
                <div><dt>Inizio</dt><dd>{{ project.startDate ? project.startDate|date('d/m/Y') : '—' }}</dd></div>
                <div><dt>Fine prevista</dt><dd class="{{ project.overdue ? 'text-danger' : '' }}">{{ project.dueDate ? project.dueDate|date('d/m/Y') : '—' }}</dd></div>
            </dl>
            {% if closure_control %}
                <dl class="project-detail-column">
                    <div><dt>Operativa</dt><dd><span class="badge {{ closure_control.operationalStatus.badgeClass }}">{{ closure_control.operationalStatus.label }}</span></dd></div>
                    <div><dt>Economica</dt><dd><span class="badge {{ closure_control.economicStatus.badgeClass }}">{{ closure_control.economicStatus.label }}</span></dd></div>
                    <div><dt>Complessiva</dt><dd><span class="badge {{ closure_control.overallStatus.badgeClass }}">{{ closure_control.overallStatus.label }}</span></dd></div>
                    <div><dt>Ore stimate / effettive</dt><dd>{{ closure_control.estimatedMinutes|duration_hm }} / {{ closure_control.actualMinutes|duration_hm }}</dd></div>
                    <div><dt>Ultimo avanzamento</dt><dd>{{ closure_control.lastOperationalAt|date('d/m/Y H:i') }}</dd></div>
                    <div><dt>Margine corrente</dt><dd class="{{ closure_control.marginCents < 0 ? 'text-danger' : 'text-success' }}">{{ closure_control.marginCents|money_eur }}</dd></div>
                    <div><dt>Da incassare</dt><dd>{{ closure_control.remainingToCollectCents|money_eur }}</dd></div>
                </dl>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block page_actions %}
<div class="btn-list">
    {% if not project.archived %}<a href="{{ path('app_activity_new', {id: project.id}) }}" class="btn btn-primary">Nuova attività</a>{% endif %}
    <a href="{{ path('app_time_entry_index', {project: project.id}) }}" class="btn btn-success">Ore della commessa</a>
    <a href="{{ path('app_attachment_project', {id: project.id}) }}" class="btn btn-primary">Documenti{% if attachment_count > 0 %} ({{ attachment_count }}){% endif %}</a>
    <a href="{{ path('app_economics_project', {id: project.id}) }}" class="btn btn-secondary">Economia</a>
    {% if closure_control %}
        <a href="{{ path('app_control_index', {client: project.client.id, responsible: project.responsible.id}) }}" class="btn btn-secondary">Controllo</a>
    {% endif %}
    {% if is_granted('ROLE_PARTNER') and project.archived %}
        <form method="post" action="{{ path('app_project_restore', {id: project.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('restore_project_' ~ project.id) }}">
            <button class="btn btn-success" type="submit">Ripristina</button>
        </form>
    {% endif %}
</div>
{% endblock %}

{% block page_body %}
{% if project.archived %}
    <div class="alert alert-secondary">Commessa archiviata il {{ project.archivedAt|date('d/m/Y H:i') }}.</div>
{% endif %}

<div class="card project-activities">
    <div class="card-header">
        <h3 class="card-title">Attività</h3>
        <span class="badge bg-secondary-lt ms-auto">{{ activities|length }}</span>
    </div>
    <div class="list-group list-group-flush">
        {% for activity in activities %}
            {% set time_summary = activity_time[activity.id]|default(null) %}
            <article class="list-group-item project-activity" aria-labelledby="activity-title-{{ activity.id }}">
                <div class="project-activity-header">
                    <div class="project-activity-heading">
                        <h4 id="activity-title-{{ activity.id }}" class="project-activity-title"><a href="{{ path(is_granted('ACTIVITY_EDIT', activity) ? 'app_activity_edit' : 'app_activity_time', {id: activity.id}) }}">{{ activity.title }}</a></h4>
                        <div class="project-activity-meta">
                            <span>{{ activity.assignee.displayName }}</span>
                            <span class="badge {{ activity.status.badgeClass }}">{{ activity.status.label }}</span>
                            {% if activity.dueAt %}<span>Scadenza {{ activity.dueAt|date('d/m/Y') }}</span>{% endif %}
                        </div>
                    </div>
                    <div class="project-activity-controls">
                        <div class="activity-progress">
                            <div class="activity-progress-label"><span>Avanzamento</span><strong>{{ activity.progressPercent }}%</strong></div>
                            <progress class="activity-progress-bar" value="{{ activity.progressPercent }}" max="100" aria-label="Avanzamento di {{ activity.title }}">{{ activity.progressPercent }}%</progress>
                        </div>
                        <a href="{{ path('app_activity_time', {id: activity.id}) }}" class="btn btn-success activity-hours-link" aria-label="Ore di {{ activity.title }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            Ore
                        </a>
                    </div>
                </div>
                <div class="project-activity-time">
                    <div class="activity-time-total"><span>Consuntivato totale:</span> <strong>{{ time_summary.total_minutes|default(0)|duration_hm }}</strong></div>
                    {% if time_summary and time_summary.contributors is not empty %}
                        <div class="table-responsive time-contributors">
                            <table class="table mb-0" data-summary-table aria-label="Ore per persona: {{ activity.title }}">
                                <thead><tr><th scope="col">Persona</th><th scope="col" class="text-end">Ore registrate</th></tr></thead>
                                <tbody>
                                    {% for contributor in time_summary.contributors %}
                                        <tr><th scope="row">{{ contributor.display_name }}</th><td class="text-end fw-semibold">{{ contributor.total_minutes|duration_hm }}</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div class="list-group-item text-secondary">Nessuna attività.</div>
        {% endfor %}
    </div>
</div>
{% endblock %}
