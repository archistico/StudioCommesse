{% extends 'layout/app.html.twig' %}

{% block title %}Documenti {{ project.code }} · {{ app_name }}{% endblock %}
{% block page_title %}Documenti · {{ project.code }}{% endblock %}
{% block page_back %}{% include 'components/back_link.html.twig' with {url: path('app_project_show', {id: project.id}), label: 'Torna alla commessa'} only %}{% endblock %}
{% block page_actions %}
<div class="btn-list">
    {% if not project.archived %}<a href="{{ path('app_attachment_new', {id: project.id, activity: selected_activity ? selected_activity.id : null}) }}" class="btn btn-primary">{% include 'components/icon.html.twig' with {name: 'upload'} only %}Carica documento</a>{% endif %}

    <a href="{{ path('app_attachment_index', {project: project.id}) }}" class="btn btn-primary">{% include 'components/icon.html.twig' with {name: 'layout-grid'} only %}Vista globale</a>
</div>
{% endblock %}

{% block page_body %}
{% if project.archived %}<div class="alert alert-secondary">La commessa è archiviata: i documenti restano consultabili ma non è possibile caricarne di nuovi.</div>{% endif %}



<details class="card mb-3 section-filters"><summary>{% include 'components/icon.html.twig' with {name: 'filter'} only %}Filtri e ricerca{% if app.request.query.all is not empty %}<span class="badge bg-blue-lt ms-2">Impostati</span>{% endif %}</summary>
    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-12 col-lg-4">
                <label class="form-label" for="project-document-activity">Attività</label>
                <select class="form-select" id="project-document-activity" name="activity">
                    <option value="">Tutte le attività</option>
                    {% for activity in activities %}<option value="{{ activity.id }}" {{ selected_activity and selected_activity.id == activity.id ? 'selected' : '' }}>{{ activity.title }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-4">
                <label class="form-label" for="project-document-classification">Classificazione</label>
                <select class="form-select" id="project-document-classification" name="classification">
                    <option value="">Tutte</option>
                    {% for classification in classifications %}<option value="{{ classification.value }}" {{ selected_classification == classification ? 'selected' : '' }}>{{ classification.label }}</option>{% endfor %}
                </select>
            </div>
            <div class="col-12 col-lg-4">
                <label class="form-label" for="project-document-query">Ricerca</label>
                <input class="form-control" id="project-document-query" name="q" value="{{ query }}" placeholder="Nome o descrizione">
            </div>
            <div class="col-12"><button class="btn btn-primary" type="submit">{% include 'components/icon.html.twig' with {name: 'filter'} only %}Filtra documenti</button></div>
        </form>
    </div>
</details>

<div class="card">
    <div class="card-header"><h3 class="card-title">{% include 'components/icon.html.twig' with {name: 'file-description'} only %}Archivio documentale</h3><span class="badge bg-blue-lt ms-auto">{{ attachments|length }}</span></div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table dt-responsive nowrap w-100 document-table" data-datatable>
            <thead><tr><th scope="col">Documento</th><th scope="col">Attività</th><th scope="col">Classificazione</th><th scope="col">Caricato da</th><th scope="col">Data</th><th scope="col">Dimensione</th></tr></thead>
            <tbody>
            {% for attachment in attachments %}
                <tr>
                    <td><a class="fw-semibold" href="{{ path('app_attachment_show', {id: attachment.id}) }}">{{ attachment.originalName }}</a>{% if attachment.description %}<div class="small text-secondary text-wrap">{{ attachment.description }}</div>{% endif %}</td>
                    <td>{{ attachment.activity ? attachment.activity.title : 'Documento generale' }}</td>
                    <td><span class="badge {{ attachment.classification.badgeClass }}">{{ attachment.classification.label }}</span></td>
                    <td>{{ attachment.uploadedBy.displayName }}</td>
                    <td data-order="{{ attachment.createdAt|date('U') }}">{{ attachment.createdAt|date('d/m/Y H:i') }}</td>
                    <td data-order="{{ attachment.sizeBytes }}">{{ attachment.sizeBytes|file_size }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-secondary">Nessun documento presente.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
