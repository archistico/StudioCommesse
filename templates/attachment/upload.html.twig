{% extends 'layout/app.html.twig' %}
{% block title %}Carica documento · {{ app_name }}{% endblock %}
{% block page_title %}Carica documento{% endblock %}
{% block page_body %}
<div class="form-page">
<p class="text-secondary">{{ project.code }} · {{ project.name }}</p>
<div class="card mb-3">
    {{ form_start(form, {attr: {autocomplete: 'off'}}) }}
    <div class="card-header"><h3 class="card-title">Carica documento</h3></div>
    <div class="card-body">
        {{ form_errors(form) }}
        <div class="row g-3">
            <div class="col-12">{{ form_row(form.file) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.classification) }}</div>
            <div class="col-12 col-md-6">{{ form_row(form.activity) }}</div>
            <div class="col-12">{{ form_row(form.description) }}</div>
        </div>
        {{ form_rest(form) }}
    </div>
    <div class="card-footer form-actions"><a class="btn btn-outline-secondary" href="{{ path('app_attachment_project', {id: project.id}) }}">Annulla</a><button class="btn btn-primary" type="submit">Carica documento</button></div>
    {{ form_end(form, {render_rest: false}) }}
</div>
</div>
{% endblock %}
