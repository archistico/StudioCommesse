{% extends 'base.html.twig' %}

{% block title %}Accesso · {{ app_name }}{% endblock %}
{% block body_class %}d-flex flex-column bg-body-tertiary{% endblock %}

{% block body %}
<main class="page page-center" id="main-content" tabindex="-1">
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            <span class="brand-mark brand-mark-lg" aria-hidden="true">SC</span>
            <h1 class="h2 mt-3 mb-1">{{ app_name }}</h1>
            <p class="text-secondary mb-0">Gestione interna di commesse e collaboratori</p>
        </div>

        <form class="card card-md" method="post" aria-describedby="login-security-note">
            <div class="card-body">
                <h2 class="h2 text-center mb-4">Accedi</h2>

                {% if error %}
                    <div class="alert alert-danger" role="alert" aria-live="assertive" tabindex="-1">
                        Credenziali non valide oppure accesso temporaneamente non disponibile.
                    </div>
                {% endif %}

                <div class="mb-3">
                    <label class="form-label" for="username">Nome utente</label>
                    <input type="text" id="username" name="_username" value="{{ error ? '' : last_username }}" class="form-control" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" id="password" name="_password" class="form-control" autocomplete="current-password" required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <div class="form-footer">
                    <button type="submit" class="btn btn-primary w-100">Accedi</button>
                </div>
                <p class="form-hint mt-3 mb-0" id="login-security-note">Dopo 5 tentativi falliti sulla stessa utenza e postazione, nuovi tentativi vengono sospesi per un’ora.</p>
            </div>
        </form>
        <div class="text-center text-secondary mt-3">
            Applicazione riservata alla rete interna dello studio.
        </div>
    </div>
</main>
{% endblock %}
