{
  "name": "studio/commesse",
  "description": "Gestionale interno per il controllo di commesse, attività e collaboratori.",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "doctrine/dbal": "^4.3",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.6",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*",
    "php": ">=8.4",
    "symfony/apache-pack": "^1.0",
    "symfony/asset": "8.1.*",
    "symfony/console": "8.1.*",
    "symfony/dotenv": "8.1.*",
    "symfony/expression-language": "8.1.*",
    "symfony/form": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/monolog-bundle": "^4.0.2",
    "symfony/password-hasher": "8.1.*",
    "symfony/property-access": "8.1.*",
    "symfony/property-info": "8.1.*",
    "symfony/rate-limiter": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/security-bundle": "8.1.*",
    "symfony/security-csrf": "8.1.*",
    "symfony/serializer": "8.1.*",
    "symfony/string": "8.1.*",
    "symfony/translation": "8.1.*",
    "symfony/twig-bundle": "8.1.*",
    "symfony/validator": "8.1.*",
    "symfony/yaml": "8.1.*",
    "twig/extra-bundle": "^3.21",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^12.2",
    "symfony/browser-kit": "8.1.*",
    "symfony/css-selector": "8.1.*",
    "symfony/maker-bundle": "^1.65",
    "symfony/phpunit-bridge": "8.1.*"
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*",
    "symfony/polyfill-php83": "*",
    "symfony/polyfill-php84": "*"
  },
  "scripts": {
    "post-install-cmd": [
      "@php bin/console cache:clear"
    ],
    "post-update-cmd": [
      "@php bin/console cache:clear"
    ],
    "lint": "php scripts/php-lint.php",
    "analyse": "php vendor/bin/phpstan analyse --memory-limit=1G",
    "test": "php vendor/bin/phpunit",
    "quality": [
      "@lint",
      "@analyse",
      "@test"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  }
}
